NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CATALOG_SOURCE=backend
# Only isolated visual previews may set this to demo. Real catalog is server-owned.
NEXT_PUBLIC_YANDEX_BUTTON=false
# Enable only with the deployed customer authentication API. Independent of catalog mode.
NEXT_PUBLIC_CUSTOMER_AUTH=
# Enable published page content when the public content API is deployed.
NEXT_PUBLIC_SITE_CONTENT=

# Server-only Ozon credentials. Never expose them with NEXT_PUBLIC_.
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_OAUTH_TOKEN=
