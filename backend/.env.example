# Local foundation only. Do not use production credentials here.
DATABASE_URL=postgresql://asaya_local:REPLACE_ME@127.0.0.1:55432/asaya_local
POSTGRES_PASSWORD=REPLACE_ME
OTP_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional: separate random key for staff sessions and encrypted authenticator seeds.
# STAFF_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
PUBLIC_ORIGIN=http://127.0.0.1:3200
COOKIE_SECURE=false
# Customer SMS v7. Store real credentials only in the protected server environment.
CUSTOMER_SMS_ENABLED=false
OTP_PROVIDER=disabled
# OTP_PROVIDER=smsaero
# SMSAERO_EMAIL=account@example.test
# SMSAERO_API_KEY=REPLACE_WITH_API_KEY_FROM_CABINET_NOT_LOGIN_PASSWORD
# SMSAERO_SIGN=APPROVED_SENDER
# Test mode calls the provider's /sms/testsend and cannot enable production login.
SMSAERO_MODE=test
# Set only after the sender/template and actual delivery latency have been checked.
SMSAERO_OTP_APPROVED=false
# Read-only CDEK tracking. This never creates transport waybills.
CDEK_TRACKING_ENABLED=false
# Task 3: optional READ-ONLY FF stock feed worker; requires migration 024.
# Keep the tokenized feed URL in this private file, never in Git or browser env.
# CDEK_STOCK_SETTINGS_FILE=/protected/path/cdek-stock-settings.json
# FF submission remains off until product/rate mappings and YCP waybill ownership are verified.
FULFILLMENT_ENABLED=false
UNPAID_RETENTION_ENABLED=false
# FULFILLMENT_SETTINGS_FILE=/protected/path/fulfillment-settings.json
# FULFILLMENT_LOGIN=SERVER_ONLY
# FULFILLMENT_PASSWORD=SERVER_ONLY
# CDEK_API_ACCOUNT=YOUR_STABLE_DELIVERY_ACCOUNT_ID
# CDEK_CLIENT_ID=SERVER_ONLY
# CDEK_CLIENT_SECRET=SERVER_ONLY
# CDEK_ENVIRONMENT=test
# CDEK_WEBHOOK_SECRET=INDEPENDENT_RANDOM_BASE64URL_SECRET_AT_LEAST_32_CHARS
# Callback: /api/integrations/cdek/<secret>. Exclude this path from proxy access logs.
# Persist this file outside disposable release directories. It prevents duplicate subscriptions after an ambiguous response.
# CDEK_WEBHOOK_STATE_FILE=/var/lib/asaya/cdek-webhook-state.json
# Only after HTTPS routing, secret rejection and proxy log exclusion were verified:
CDEK_WEBHOOK_ENDPOINT_VERIFIED=false
# Read-only subscription check: node dist/scripts/cdek-webhook.js --status
# One-time registration, preserving other integrations: node dist/scripts/cdek-webhook.js --ensure
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_SEND_PER_IP_PER_HOUR=20
OTP_SEND_PER_PHONE_PER_HOUR=5
OTP_VERIFY_PER_IP_PER_FIVE_MINUTES=30
# Customer sign-in: public Client ID of a Yandex ID authorization application.
# Requires HTTPS PUBLIC_ORIGIN, COOKIE_SECURE=true and migration 018.
# Register redirect URI: https://asaya.ru/api/store/v1/auth/yandex/callback
# PKCE is used; a Client secret is not required.
# YANDEX_ID_CLIENT_ID=32_HEXADECIMAL_CHARACTERS
# Optional YCP test integration. Both values are required to enable it.
# YCP_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
# YCP_SETTINGS_FILE=/absolute/path/to/private-ycp-settings.json
