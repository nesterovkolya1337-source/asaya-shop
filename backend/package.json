{
  "name": "@asaya/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/server.js",
    "preview:checkout": "npm run build && node dist/scripts/preview-checkout.js",
    "create:admin": "node --env-file=.env dist/scripts/create-admin.js",
    "dev": "node --watch dist/src/server.js",
    "migrate": "node dist/scripts/migrate.js",
    "import:catalog": "node dist/scripts/import-catalog.js",
    "approve:mappings": "node dist/scripts/approve-mappings.js",
    "yandex:feed": "node dist/scripts/yandex-feed.js",
    "reservations:expire": "node dist/scripts/expire-reservations.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "saxes": "6.0.0",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "7.0.2"
  }
}
