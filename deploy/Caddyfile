asaya.ru, www.asaya.ru {
  encode zstd gzip

  @www host www.asaya.ru
  redir @www https://asaya.ru{uri} 308

  # Legal aliases must redirect at the HTTP layer, including the static build.
  @legacy_cookies path /legal/cookies /legal/cookies/
  redir @legacy_cookies /legal/privacy/ 301
  @legacy_offer path /offer /offer/
  redir @legacy_offer /legal/offer/ 301
  @legacy_payment path /payment /payment/
  redir @legacy_payment /delivery/ 301
  @legacy_return path /return /return/
  redir @legacy_return /returns/ 301

  # OAuth authorization codes are one-use credentials. Keep the callback out of
  # access logs and prevent its URL becoming a referrer on the following page.
  @customer_oauth path /api/store/v1/auth/yandex/*
  log_skip @customer_oauth
  header @customer_oauth >Referrer-Policy "no-referrer"

  @cdek_callback path /api/integrations/cdek/*
  log_skip @cdek_callback
  handle @cdek_callback {
    header X-Robots-Tag "noindex, nofollow"
    reverse_proxy asaya-catalog-api:3100
  }

  @admin_entry path /admin /admin/ /manage
  redir @admin_entry /manage/admin/ 302

  handle /manage/* {
    header X-Robots-Tag "noindex, nofollow"
    reverse_proxy asaya-catalog-web:3200
  }

  @product_analytics path /api/store/v1/analytics/events
  log_skip @product_analytics

  @catalog_api path /api/admin/v1/* /api/store/v1/*
  handle @catalog_api {
    header X-Robots-Tag "noindex, nofollow"
    reverse_proxy asaya-catalog-api:3100
  }

  handle /_asaya_deploy/* {
    reverse_proxy unix//run/asaya-deploy/deploy.sock
  }

  handle {
    reverse_proxy web:80
  }

  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  log {
    output stdout
    format console
  }
}
